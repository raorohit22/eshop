<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Verify Your Eshop Account</title>
  <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@400;600;700;800&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
  <style type="text/css">
    /* Responsive & Client-Specific Styles */
    body {
      margin: 0;
      padding: 0;
      width: 100% !important;
      -webkit-text-size-adjust: 100%;
      -ms-text-size-adjust: 100%;
      background-color: #0B0F19;
    }
    img {
      border: 0;
      height: auto;
      line-height: 100%;
      outline: none;
      text-decoration: none;
    }
    table {
      border-collapse: collapse !important;
    }
    /* Hover transitions (supported in Apple Mail / modern clients) */
    .btn-action:hover {
      background: linear-gradient(135deg, #6366F1 0%, #4F46E5 100%) !important;
      box-shadow: 0px 4px 20px rgba(99, 102, 241, 0.4) !important;
    }
  </style>
</head>
<body style="background-color: #0B0F19; font-family: 'Outfit', 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif; -webkit-font-smoothing: antialiased; padding: 40px 0; margin: 0;">
  
  <table border="0" cellpadding="0" cellspacing="0" width="100%" style="background-color: #0B0F19;">
    <tr>
      <td align="center" style="padding: 10px;">
        <!-- Main Card Container -->
        <table border="0" cellpadding="0" cellspacing="0" width="100%" style="max-width: 500px; background-color: #111827; border: 1px solid #1F2937; border-radius: 16px; overflow: hidden; box-shadow: 0 20px 25px -5px rgba(0,0,0,0.5), 0 10px 10px -5px rgba(0,0,0,0.4);">
          
          <!-- Top Accent Bar (Gradient) -->
          <tr>
            <td height="6" style="background-color: #6366F1; background: linear-gradient(90deg, #6366F1 0%, #8B5CF6 50%, #EC4899 100%);"></td>
          </tr>
          
          <!-- Logo & Header Section -->
          <tr>
            <td align="center" style="padding: 40px 40px 20px 40px;">
              <table border="0" cellpadding="0" cellspacing="0">
                <tr>
                  <td align="center" style="background-color: #1F2937; background: linear-gradient(135deg, #1E293B 0%, #0F172A 100%); padding: 12px 20px; border-radius: 12px; border: 1px solid #334155;">
                    <!-- Beautiful CSS Logo -->
                    <span style="font-size: 22px; font-weight: 800; letter-spacing: 1px; color: #FFFFFF; font-family: 'Outfit', 'Inter', sans-serif; display: flex; align-items: center; justify-content: center;">
                      <span style="display: inline-block; width: 10px; height: 10px; border-radius: 50%; background-color: #6366F1; background: linear-gradient(135deg, #6366F1 0%, #EC4899 100%); margin-right: 10px;"></span>
                      E<span style="color: #6366F1;">S</span>HOP
                    </span>
                  </td>
                </tr>
              </table>
            </td>
          </tr>
          
          <!-- Welcome & Heading -->
          <tr>
            <td align="center" style="padding: 0 40px 10px 40px;">
              <h1 style="color: #FFFFFF; font-size: 24px; font-weight: 700; margin: 20px 0 10px 0; letter-spacing: -0.5px; line-height: 32px;">
                Verify Your Account
              </h1>
              <p style="color: #9CA3AF; font-size: 12px; font-weight: 600; margin: 0; text-transform: uppercase; letter-spacing: 1.5px;">
                ONE-TIME VERIFICATION CODE
              </p>
            </td>
          </tr>
          
          <!-- Divider -->
          <tr>
            <td align="center" style="padding: 10px 40px;">
              <table border="0" cellpadding="0" cellspacing="0" width="100%">
                <tr>
                  <td height="1" style="background-color: #1F2937;"></td>
                </tr>
              </table>
            </td>
          </tr>
          
          <!-- Main Content Body -->
          <tr>
            <td style="padding: 20px 40px; text-align: left;">
              <p style="color: #E5E7EB; font-size: 16px; line-height: 24px; margin: 0 0 16px 0;">
                Hello <strong style="color: #F3F4F6;"><%= name %></strong>,
              </p>
              <p style="color: #9CA3AF; font-size: 15px; line-height: 24px; margin: 0 0 24px 0;">
                Thank you for creating an account on Eshop. To complete your registration and activate your account, please enter the 4-digit verification code below on the activation screen.
              </p>
            </td>
          </tr>
          
          <!-- OTP Display Block -->
          <tr>
            <td align="center" style="padding: 0 40px 30px 40px;">
              <table border="0" cellpadding="0" cellspacing="0">
                <tr>
                  <td align="center" style="background-color: #0F172A; border: 1px solid #1E293B; border-radius: 12px; padding: 24px 32px; box-shadow: inset 0 2px 4px rgba(0,0,0,0.6);">
                    <!-- OTP Code Grid for maximum visual impact -->
                    <table border="0" cellpadding="0" cellspacing="0">
                      <tr>
                        <% for (let i = 0; i < otp.length; i++) { %>
                          <td>
                            <div style="display: inline-block; width: 44px; height: 52px; line-height: 52px; text-align: center; background-color: #1E293B; border: 1px solid #334155; border-radius: 8px; font-size: 26px; font-weight: 800; color: #8B5CF6; margin: 0 6px; font-family: Monaco, Consolas, monospace; text-shadow: 0 0 10px rgba(139, 92, 246, 0.4);"><%= otp[i] %></div>
                          </td>
                        <% } %>
                      </tr>
                    </table>
                  </td>
                </tr>
              </table>
            </td>
          </tr>
          
          <!-- Security Notice & Countdown -->
          <tr>
            <td style="padding: 0 40px 30px 40px;">
              <table border="0" cellpadding="0" cellspacing="0" width="100%" style="background-color: rgba(31, 41, 55, 0.4); border: 1px solid rgba(245, 158, 11, 0.2); border-radius: 10px; padding: 16px;">
                <tr>
                  <td width="20" valign="top" style="padding-top: 2px;">
                    <!-- Shield/Warning Emoji/Symbol -->
                    <span style="font-size: 16px; line-height: 1;">⚠️</span>
                  </td>
                  <td style="color: #D1D5DB; font-size: 13px; line-height: 20px; padding-left: 8px;">
                    <strong style="color: #F59E0B;">Security Warning:</strong> This verification code is valid for exactly <strong style="color: #F59E0B;">5 minutes</strong>. If you did not request this activation email, please secure your account immediately or contact support.
                  </td>
                </tr>
              </table>
            </td>
          </tr>
          
          <!-- Divider -->
          <tr>
            <td align="center" style="padding: 0 40px;">
              <table border="0" cellpadding="0" cellspacing="0" width="100%">
                <tr>
                  <td height="1" style="background-color: #1F2937;"></td>
                </tr>
              </table>
            </td>
          </tr>
          
          <!-- Bottom Brand Message -->
          <tr>
            <td align="center" style="padding: 30px 40px 40px 40px;">
              <p style="color: #9CA3AF; font-size: 13px; line-height: 20px; margin: 0 0 8px 0;">
                Questions? Need help?
              </p>
              <a href="#" style="color: #6366F1; font-size: 13px; font-weight: 600; text-decoration: none; display: inline-block;">
                Visit our Help Center &rarr;
              </a>
            </td>
          </tr>
          
        </table>
        <!-- Card Container End -->
        
        <!-- Footer -->
        <table border="0" cellpadding="0" cellspacing="0" width="100%" style="max-width: 500px; margin-top: 24px;">
          <tr>
            <td align="center" style="padding: 0 20px;">
              <p style="color: #4B5563; font-size: 12px; line-height: 18px; margin: 0 0 8px 0; text-align: center;">
                &copy; 2026 Eshop Inc. All rights reserved.
              </p>
              <p style="color: #4B5563; font-size: 11px; line-height: 16px; margin: 0; text-align: center;">
                You are receiving this email because you registered an account on Eshop. 
                If you believe this is in error, please disregard this email.
              </p>
            </td>
          </tr>
        </table>
        
      </td>
    </tr>
  </table>

</body>
</html>